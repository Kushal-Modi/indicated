# ============================================================
# AI-Powered F&O Market Dashboard — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# MOCK_MODE=True lets you run the full app with zero API keys.

# ----------------------------------------------------------
# CORE APP SETTINGS
# ----------------------------------------------------------
# Enable mock/simulated mode (True = no broker/LLM keys needed)
MOCK_MODE=True

# Default index symbol: NIFTY | BANKNIFTY | FINNIFTY | SENSEX
SYMBOL=NIFTY

# Default chart timeframe: 5m | 15m | 1h
TIMEFRAME=5m

# Auto-refresh interval in seconds (0 = disable)
AUTO_REFRESH_SECONDS=60

# ----------------------------------------------------------
# BROKER API CONFIGURATION
# ----------------------------------------------------------
# Broker name: upstox | dhan | zerodha
BROKER_NAME=upstox

# Your broker API credentials
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here

# Zerodha-specific (Kite Connect)
# BROKER_REQUEST_TOKEN=your_request_token_here

# ----------------------------------------------------------
# LLM / AI CONFIGURATION
# ----------------------------------------------------------
# Provider: gemini | openai  (leave blank to use rule-based fallback)
LLM_PROVIDER=gemini

# Your LLM API key (Gemini or OpenAI)
# If blank, the app uses a smart rule-based keyword sentiment engine
LLM_API_KEY=your_llm_api_key_here

# LLM model names (defaults shown below)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# RSS NEWS FEEDS (pre-configured, modify if needed)
# ----------------------------------------------------------
# Comma-separated RSS URLs for Indian financial news
RSS_FEEDS=https://www.moneycontrol.com/rss/latestnews.xml,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.livemint.com/rss/markets
